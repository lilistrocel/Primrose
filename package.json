{
  "name": "primrose-backend",
  "version": "1.0.0",
  "description": "Modular backend framework with user authentication",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon src/index.ts",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "rimraf dist",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:auth": "jest --testPathPattern=auth",
    "services:start": "node scripts/start-services.js",
    "services:logs": "node scripts/log-viewer.js",
    "db:seed": "node scripts/seed-database.js",
    "inventory:seed": "npm run build && node scripts/seed-inventory.js",
    "csv:import": "npm run build && node scripts/import-csvs.js",
    "csv:count": "npm run build && node scripts/count-inventory.js",
    "csv:clear": "npm run build && node scripts/clear-inventory.js",
    "csv:clear:force": "npm run build && node scripts/clear-inventory.js --force",
    "health-check": "node scripts/health-check.js",
    "start:simple": "node src/index.ts",
    "win:start": "start.bat",
    "docker:start": "node scripts/docker-services.js start",
    "docker:stop": "node scripts/docker-services.js stop",
    "docker:status": "node scripts/docker-services.js status",
    "docker:logs": "node scripts/docker-services.js logs",
    "docker:restart": "node scripts/docker-services.js restart",
    "deploy:dev": "node scripts/deploy.js deploy development",
    "deploy:staging": "node scripts/deploy.js deploy staging",
    "deploy:prod": "node scripts/deploy.js deploy production",
    "deploy:rollback": "node scripts/deploy.js rollback",
    "deploy:health": "node scripts/deploy.js health",
    "deploy:backup": "node scripts/deploy.js backup",
    "lint": "eslint src/ --ext .ts --fix",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "node scripts/security-check.js",
    "aws:setup": "node scripts/aws-setup.js",
    "ci:full": "npm run lint && npm run security:audit && npm test && npm run build",
    "fullstack:start": "node scripts/start-fullstack.js",
    "frontend:install": "cd frontend && npm install",
    "frontend:build": "cd frontend && npm run build",
    "frontend:test": "cd frontend && npm test"
  },
  "keywords": [
    "typescript",
    "express",
    "mongodb",
    "auth",
    "modular"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.4.5",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "mongoose": "^7.4.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.8",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "chalk": "^4.1.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.1.3",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "winston": "^3.11.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.ts"
    ]
  }
}
